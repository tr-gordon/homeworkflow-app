# HomeworkFlow has no server, database, accounts or API keys. Nothing here is secret,
# and nothing needs to be set for normal use. Copy to .env.local only if you need these.

# Demo mode: fictional sample data (separate storage key), for local UI testing and demos.
NEXT_PUBLIC_DEMO_MODE=false

# Sub-path when hosted under a project URL, e.g. GitHub Pages at
# https://<user>.github.io/Homeworkflow/  ->  /Homeworkflow
# Leave empty for a root domain or local use. Needed at BUILD time.
NEXT_PUBLIC_BASE_PATH=
