{
  "name": "homeworkflow",
  "version": "0.1.0",
  "private": true,
  "description": "Homework time management PWA for a student and a linked parent.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "npm run check:privacy && npm run typecheck && npm run lint && npm test && npm run build"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.4",
    "typescript": "5.9",
    "vitest": "^5.1.0"
  }
}
